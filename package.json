{
  "name": "playwright-coverage",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs & rspack dev",
    "build": "rspack build",
    "test:e2e": "playwright test",
    "test:e2e:uncommitted": "DIFF_BASE=HEAD playwright test",
    "report": "node scripts/report.mjs",
    "check:scan": "node scripts/scan.check.mjs",
    "typecheck": "tsc --noEmit",
    "build-report": "npm run test:e2e:uncommitted && DIFF_BASE=HEAD npm run report"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "redux-saga": "^1.6.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@rspack/cli": "^2.3.2",
    "@rspack/core": "^2.3.2",
    "@rspack/dev-server": "^2.2.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "swc-plugin-coverage-instrument": "^0.0.33",
    "typescript": "^5.9.3"
  }
}
